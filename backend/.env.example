# ---------------------------------------------------------------------------
# Synapse - Real-Time Train Information API Configuration
# ---------------------------------------------------------------------------
# To use live Indian Railways data via RapidAPI:
# 1. Sign up on https://rapidapi.com/
# 2. Subscribe to an Indian Railway API (e.g. 'indian-railway-irctc' or similar)
# 3. Paste your credentials below:

RAPIDAPI_KEY=
RAPIDAPI_HOST=indian-railway-irctc.p.rapidapi.com
RAPIDAPI_BASE_URL=https://indian-railway-irctc.p.rapidapi.com/api/trains/v1/train/status

# In-memory TTL cache duration (in seconds) to prevent exceeding API limits
REALTIME_CACHE_TTL_SECONDS=90

# Request timeout in seconds
REALTIME_TIMEOUT_SECONDS=5.0

